<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageInstanceCompResource"
    PanScroll="{Binding ElementName=PanBack}">
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">
                <local:MySearchBox Margin="0,15" HintText="搜索模组…" x:Name="SearchBox" TextChanged="SearchRun" />
                <local:MyCard Margin="0,0,0,15" x:Name="PanManage">
                    <WrapPanel Margin="15,8,0,15">
                        <local:MyButton x:Name="BtnManageOpen" Click="BtnOpenFolder_Click" MinWidth="110"
                                         Text="打开模组目录" Padding="13,7" Margin="0,7,15,0"
                                         HorizontalAlignment="Left" ColorType="Highlight" />
                    </WrapPanel>
                </local:MyCard>
                <local:MyCard x:Name="PanListCard" Margin="0,0,0,15" Title="模组" MinHeight="55" Visibility="Collapsed">
                    <StackPanel x:Name="PanList" Margin="20,40,18,10" Orientation="Vertical" VerticalAlignment="Top" />
                </local:MyCard>
                <local:MyCard x:Name="PanEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" Visibility="Collapsed">
                    <StackPanel Margin="20,17">
                        <TextBlock x:Name="TxtEmptyTitle" Margin="0,0,0,9" HorizontalAlignment="Center" Text="暂无模组"
                                   FontSize="19" UseLayoutRounding="True" SnapsToDevicePixels="True"
                                   Foreground="{DynamicResource ColorBrush3}" />
                        <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                        <TextBlock x:Name="TxtEmptyDescription" Margin="10,10,10,0"
                                   Text="GameData 目录下尚未安装模组" TextWrapping="Wrap" HorizontalAlignment="Center" />
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>
        <local:MyCard x:Name="PanLoad" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0" UseAnimation="False">
            <local:MyLoading Text="正在加载模组…" Margin="20,20,20,17" x:Name="Load" HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
        </local:MyCard>
    </Grid>
</local:MyPageRight>
