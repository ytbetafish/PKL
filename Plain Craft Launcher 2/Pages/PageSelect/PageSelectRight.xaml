<local:MyPageRight x:Class="PCL.Pages.PageSelectRight"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  PanScroll="{Binding ElementName=PanBack}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:MySearchBox x:Name="PanVerSearchBox" Grid.Row="0" Margin="25,15,25,12"
                           HintText="搜索 KSP 实例目录" TextChanged="PanSearchBox_TextChanged" />

        <local:MyScrollViewer Grid.Row="1" x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanMain" Margin="25,2,25,10" Grid.IsSharedSizeScope="True" />
        </local:MyScrollViewer>

        <local:MyCard Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                      x:Name="PanEmpty" UseAnimation="False">
            <StackPanel Margin="20,17">
                <TextBlock Margin="0,0,0,9" HorizontalAlignment="Center" Text="还没有添加 KSP 实例"
                           FontSize="19" UseLayoutRounding="True" SnapsToDevicePixels="True"
                           Foreground="{DynamicResource ColorBrush3}" />
                <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                <TextBlock Margin="10,15,10,5" Text="点击下方按钮选择 KSP 安装目录，将其添加到实例列表。"
                           TextWrapping="Wrap" />
                <local:MyButton Height="35" HorizontalAlignment="Center" x:Name="BtnEmptyAdd" MinWidth="140"
                                Click="BtnEmptyAdd_Click" Text="添加 KSP 实例" Margin="0,10,0,0"
                                Padding="13,0" ColorType="Highlight" />
            </StackPanel>
        </local:MyCard>

        <local:MyCard Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                      x:Name="PanEmptySearch" UseAnimation="False">
            <StackPanel Margin="20,17">
                <TextBlock Margin="0,0,0,9" HorizontalAlignment="Center" Text="没有匹配的实例"
                           FontSize="19" UseLayoutRounding="True" SnapsToDevicePixels="True"
                           Foreground="{DynamicResource ColorBrush3}" />
                <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                <TextBlock Margin="10,15,10,5" Text="没有找到与搜索内容匹配的 KSP 实例目录。" TextWrapping="Wrap" />
            </StackPanel>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
