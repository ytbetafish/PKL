<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PCL.PageModDetail"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25">
            <local:MyCard Margin="0,0,0,15">
                <StackPanel Margin="20">
                    <TextBlock x:Name="LabTitle" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" />
                    <TextBlock x:Name="LabAuthor" FontSize="14" Foreground="Gray" Margin="0,0,0,10" />
                    <TextBlock x:Name="LabDescription" FontSize="14" Foreground="LightGray" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard>
                <StackPanel Margin="20">
                    <TextBlock Text="版本列表" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" />
                    <TextBlock Text="暂未实现" Foreground="Gray" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
