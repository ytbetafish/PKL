<UserControl x:Class="PCL.Pages.PageHome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL">
    <Grid Margin="32">
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                Background="{DynamicResource ColorBrush3}" CornerRadius="8" Padding="28">
            <StackPanel>
                <TextBlock Text="Kerbal Space Program" FontSize="26" FontWeight="Light"
                           Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,2" />
                <TextBlock Text="KSP 启动器" FontSize="13" Opacity="0.6" Margin="0,0,0,20" />

                <TextBlock Text="KSP 安装路径" FontSize="12" Opacity="0.7" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource ColorBrushTransparentBackground}" CornerRadius="4" Padding="12,9">
                        <TextBlock x:Name="LabKspPath" Text="未选择" Opacity="0.75"
                                   FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Border>
                    <local:MyButton Grid.Column="1" Text="选择路径" Width="96" Margin="10,0,0,0"
                                    Click="BtnPickPath_Click" />
                </Grid>

                <TextBlock x:Name="LabKspVersion" Text="" FontSize="12" Opacity="0.6" Margin="0,0,0,24" />

                <local:MyButton x:Name="BtnLaunch" Text="启动 KSP" Height="44"
                                ColorType="Highlight" Click="BtnLaunch_Click" HorizontalAlignment="Stretch" />
                <TextBlock x:Name="LabKspStatus" Text="" FontSize="12" Opacity="0.7"
                           Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
