<local:MyPageRight x:Class="PCL.Pages.PageHome"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,25,25,10">

            <local:MyCard Margin="0,0,0,15" Title="KSP 启动">
                <StackPanel Margin="25,38,23,18">
                    <TextBlock Text="KSP 安装路径" FontSize="12.5" Opacity="0.7" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource ColorBrushTransparentBackground}" CornerRadius="4" Padding="12,9">
                            <TextBlock x:Name="LabKspPath" Text="未选择" Opacity="0.8"
                                       FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Border>
                        <local:MyButton Grid.Column="1" Text="选择路径" Width="96" Margin="10,0,0,0"
                                        Click="BtnPickPath_Click" />
                    </Grid>
                    <TextBlock x:Name="LabKspVersion" Text="" FontSize="12" Opacity="0.6" Margin="0,0,0,16" />
                    <local:MyButton x:Name="BtnLaunch" Text="启动 KSP" Height="42"
                                    ColorType="Highlight" Click="BtnLaunch_Click" HorizontalAlignment="Stretch" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="KSP 状态">
                <TextBlock x:Name="LabKspStatus" Margin="25,38,23,18" Text=""
                           FontSize="12.5" Opacity="0.8" TextWrapping="Wrap" />
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
