<UserControl x:Class="PCL.Pages.PageHome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
            <TextBlock Text="PKL - KSP Launcher" FontSize="28" FontWeight="Light" Margin="0,0,0,8" />
            <TextBlock Text="Kerbal Space Program 启动器外壳" FontSize="14" Opacity="0.6" Margin="0,0,0,32" />

            <TextBlock Text="KSP 安装路径：" FontSize="13" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PanPath" Background="{DynamicResource ColorBrush3}" CornerRadius="6" Padding="12,8">
                    <TextBlock x:Name="LabKspPath" Text="未选择" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </Border>
                <Button Grid.Column="1" Content="选择路径" Margin="10,0,0,0" Padding="16,8" Click="BtnPickPath_Click" />
            </Grid>

            <TextBlock x:Name="LabKspVersion" Text="" FontSize="12" Opacity="0.6" Margin="0,0,0,32" />

            <Button x:Name="BtnLaunch" Content="启动 KSP" Padding="20,12" FontSize="14" Click="BtnLaunch_Click" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
