<local:MyPageLeft x:Class="PCL.PageLaunchLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：版本号 + 路径 -->
        <StackPanel Grid.Row="0" Margin="20,20,20,0">
            <TextBlock x:Name="LabKspVersion" Text="KSP" FontSize="18" Opacity="0.9" />
            <TextBlock x:Name="LabKspPath" Text="" FontSize="12" Opacity="0.6"
                       Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 中间：大启动卡片按钮，两行文字 -->
        <Border x:Name="BtnLaunch" Grid.Row="1" Margin="20,0,20,0" VerticalAlignment="Center"
                Background="{DynamicResource ColorBrushTransparentBackground}"
                CornerRadius="6" BorderBrush="{DynamicResource ColorBrushHighlight}"
                BorderThickness="1.5"
                MouseLeftButtonUp="BtnLaunch_Click" Cursor="Hand">
            <StackPanel VerticalAlignment="Center" Margin="20,16">
                <TextBlock x:Name="LabLaunchTitle" Text="启动 KSP" FontSize="16" HorizontalAlignment="Center"
                           Foreground="{DynamicResource ColorBrushText}" />
                <TextBlock x:Name="LabVersion" Text="" FontSize="11" HorizontalAlignment="Center"
                           Margin="0,4,0,0" Foreground="{DynamicResource ColorBrushGray3}" />
            </StackPanel>
        </Border>

        <!-- 底部：两个小按钮均分宽度 -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:MyButton x:Name="BtnInstance" Height="35" HorizontalAlignment="Stretch"
                            Text="打开 KSP 目录" Click="BtnOpenDir_Click" />
            <local:MyButton x:Name="BtnMore" Grid.Column="2" Height="35" HorizontalAlignment="Stretch"
                            Text="实例设置" Click="BtnGotoSettings_Click" />
        </Grid>
    </Grid>
</local:MyPageLeft>
