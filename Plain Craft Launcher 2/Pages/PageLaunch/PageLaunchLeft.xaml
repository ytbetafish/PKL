<local:MyPageLeft x:Class="PCL.PageLaunchLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0：顶部版本号 + 路径 -->
        <StackPanel Grid.Row="0" Margin="20,20,20,0">
            <TextBlock x:Name="LabKspVersion" Text="KSP" FontSize="18" Opacity="0.9" />
            <TextBlock x:Name="LabKspPath" Text="" FontSize="12" Opacity="0.6"
                       Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Row 1：空白 -->

        <!-- Row 2：大启动按钮 + 浮在底部的版本号 -->
        <Grid Grid.Row="2" Margin="20,0,20,0">
            <local:MyButton x:Name="BtnLaunch" Height="54"
                            Text="启动 KSP" ColorType="Highlight"
                            Padding="30,0,30,15" Click="BtnLaunch_Click" />
            <TextBlock x:Name="LabVersion" Margin="35,0,35,10" IsHitTestVisible="False"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       FontSize="11" Foreground="{DynamicResource ColorBrushGray3}" />
        </Grid>

        <!-- Row 3：两个小按钮均分宽度 -->
        <Grid Grid.Row="3" Margin="20,10,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:MyButton x:Name="BtnInstance" Height="35" HorizontalAlignment="Stretch"
                            Text="打开 KSP 目录" Click="BtnOpenDir_Click" />
            <local:MyButton x:Name="BtnMore" Grid.Column="2" Height="35" HorizontalAlignment="Stretch"
                            Text="实例设置" Click="BtnGotoSettings_Click" />
        </Grid>
    </Grid>
</local:MyPageLeft>
