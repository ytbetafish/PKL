<local:MyPageLeft x:Class="PCL.PageLaunchLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：版本号 + 路径 -->
        <StackPanel Grid.Row="0" Margin="20,20,20,0">
            <TextBlock x:Name="LabKspVersion" Text="KSP" FontSize="18" Opacity="0.9" />
            <TextBlock x:Name="LabKspPath" Text="" FontSize="12" Opacity="0.6"
                       Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 中间：大启动按钮垂直居中 -->
        <Grid Grid.Row="1" Margin="20,0,20,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <local:MyButton x:Name="BtnLaunch" Height="54"
                            Text="启动 KSP" ColorType="Highlight"
                            Click="BtnLaunch_Click" Padding="30,0,30,15" />
            <TextBlock x:Name="LabVersion" Grid.Row="1" Text="" Margin="35,8,35,0"
                       HorizontalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource ColorBrushGray3}" />
        </Grid>

        <!-- 底部：两个小按钮均分宽度 -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:MyButton x:Name="BtnInstance" Height="35"
                            Text="打开 KSP 目录" Click="BtnOpenDir_Click" />
            <local:MyButton x:Name="BtnMore" Grid.Column="2" Height="35"
                            Text="实例设置" Click="BtnGotoSettings_Click" />
        </Grid>
    </Grid>
</local:MyPageLeft>
