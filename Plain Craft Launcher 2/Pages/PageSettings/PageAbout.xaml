<local:MyPageRight x:Class="PCL.Pages.PageAbout"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="关于 PKL">
                <StackPanel Margin="25,37,25,15">
                    <TextBlock Text="PKL - Kerbal Space Program Launcher" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" />
                    <TextBlock Text="基于 PCL-CE 二次开发的 KSP 启动器" Margin="0,0,0,10" Foreground="#888" />
                    <TextBlock Text="版本: v1.0.0" Margin="0,0,0,5" />
                    <TextBlock Text="开源协议: GPL-3.0" Margin="0,0,0,20" />
                    <TextBlock Text="致谢" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />
                    <TextBlock Text="• PCL-CE (Plain Craft Launcher Community Edition) - 原版启动器框架" Margin="0,0,0,5" />
                    <TextBlock Text="• CKAN - KSP 模组管理工具" Margin="0,0,0,5" />
                    <TextBlock Text="• Kerbal Space Program - 游戏本身" Margin="0,0,0,20" />
                    <TextBlock Text="本项目仅供学习交流使用，请勿用于商业用途。" Foreground="#666" FontSize="12" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
