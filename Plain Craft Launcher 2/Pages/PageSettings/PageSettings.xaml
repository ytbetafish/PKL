<local:MyPageRight x:Class="PCL.Pages.PageSettings"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,25,25,10">

            <local:MyCard Margin="0,0,0,15" Title="KSP 设置">
                <TextBlock Margin="25,38,23,18" FontSize="12.5" Opacity="0.7"
                           TextWrapping="Wrap">KSP 安装目录在主页「KSP 启动」卡片中选择，此处仅查看。</TextBlock>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="模组描述翻译服务">
                <StackPanel Margin="25,38,23,18">
                    <TextBlock Text="翻译接口 Base URL" FontSize="12" Opacity="0.7" Margin="0,0,0,5" />
                    <local:MyTextBox x:Name="TxtBaseUrl" Height="34" Margin="0,0,0,12" />

                    <TextBlock Text="API Key" FontSize="12" Opacity="0.7" Margin="0,0,0,5" />
                    <local:MyTextBox x:Name="TxtApiKey" Height="34" Margin="0,0,0,12" />

                    <TextBlock Text="模型" FontSize="12" Opacity="0.7" Margin="0,0,0,5" />
                    <local:MyTextBox x:Name="TxtModel" Height="34" Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnSave" Text="保存设置" Width="110" Height="34"
                                        ColorType="Highlight" Click="BtnSave_Click" />
                        <TextBlock x:Name="LabSaved" Grid.Column="1" Text="" FontSize="12" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="关于">
                <StackPanel Margin="25,38,23,18">
                    <TextBlock Text="PKL - KSP Launcher" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="基于 PCL-CE 二次开发，模组数据通过 CKAN 元数据索引获取。"
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
