<UserControl x:Class="PCL.Pages.PageSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Margin="40">
        <StackPanel MaxWidth="560">
            <TextBlock Text="翻译服务设置" FontSize="20" FontWeight="Light" Margin="0,0,0,20" />

            <TextBlock Text="OpenAI 兼容 Base URL" Margin="0,0,0,4" />
            <TextBox x:Name="TxtBaseUrl" Padding="8,6" Margin="0,0,0,12" />

            <TextBlock Text="API Key" Margin="0,0,0,4" />
            <TextBox x:Name="TxtApiKey" Padding="8,6" Margin="0,0,0,12" />

            <TextBlock Text="模型名" Margin="0,0,0,4" />
            <TextBox x:Name="TxtModel" Padding="8,6" Margin="0,0,0,20" />

            <Button Content="保存" Padding="20,8" HorizontalAlignment="Left" Click="BtnSave_Click" />
            <TextBlock x:Name="LabSaved" Text="" Margin="0,12,0,0" Foreground="Green" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
