<local:MyPageRight x:Class="PCL.Pages.PageTranslate"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="翻译服务">
                <StackPanel Margin="25,37,25,15">
                    <Grid IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,25,0" Text="API 地址" />
                        <local:MyTextBox Grid.Row="0" Grid.Column="1" x:Name="TxtBaseUrl" Height="34" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,25,0" Text="API 密钥" />
                        <local:MyTextBox Grid.Row="2" Grid.Column="1" x:Name="TxtApiKey" Height="34" />
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Margin="0,0,25,0" Text="模型" />
                        <local:MyTextBox Grid.Row="4" Grid.Column="1" x:Name="TxtModel" Height="34" />
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,15" Title="网络设置">
                <StackPanel Margin="25,37,25,15">
                    <Grid IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,25,0" Text="HTTP 代理" />
                        <local:MyTextBox Grid.Row="0" Grid.Column="1" x:Name="TxtProxy" Height="34" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,25,0" Text="下载并发数" />
                        <local:MyTextBox Grid.Row="2" Grid.Column="1" x:Name="TxtConcurrency" Height="34" />
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Margin="0,0,25,0" Text="超时时间（秒）" />
                        <local:MyTextBox Grid.Row="4" Grid.Column="1" x:Name="TxtTimeout" Height="34" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <local:MyButton Text="保存" Height="34" Width="100" Click="BtnSave_Click" />
                        <TextBlock x:Name="LabSaved" Text="" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="#4CAF50" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
