<local:MyPageRight x:Class="PCL.Pages.PageMods"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,25,25,10">

            <local:MyCard Margin="0,0,0,15" Title="搜索 KSP 模组">
                <StackPanel Margin="25,38,23,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MySearchBox x:Name="TxtSearch" HintText="搜索 KSP 模组（名称 / 作者 / ID）"
                                           Search="BtnSearch_Click" />
                        <local:MyButton Grid.Column="1" x:Name="BtnFilterAll" Text="全部" Width="80" Margin="12,0,0,0"
                                        Click="BtnFilterAll_Click" />
                        <local:MyButton Grid.Column="2" x:Name="BtnUpdateAll" Text="更新全部" Width="90" Margin="10,0,0,0"
                                        Click="BtnUpdateAll_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <local:MyButton x:Name="BtnFilterInstalled" Text="已安装" Width="90"
                                        Click="BtnFilterInstalled_Click" />
                        <local:MyButton x:Name="BtnFilterUpdates" Text="有更新" Width="90" Margin="10,0,0,0"
                                        Click="BtnFilterUpdates_Click" />
                        <local:MyButton x:Name="BtnFilterNotInstalled" Text="未安装" Width="90" Margin="10,0,0,0"
                                        Click="BtnFilterNotInstalled_Click" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="搜索结果">
                <Border Margin="25,38,23,18" Background="{DynamicResource ColorBrushTransparentBackground}" CornerRadius="4">
                    <DataGrid x:Name="GridMods" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionChanged="GridMods_SelectionChanged" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0"
                              RowBackground="Transparent" AlternatingRowBackground="{DynamicResource ColorBrush3}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="作者" Binding="{Binding Author}" Width="*" />
                            <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="Auto" />
                            <DataGridTextColumn Header="简介" Binding="{Binding Description}" Width="3*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="状态" Width="Auto">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0}{1}">
                                        <Binding Path="IsInstalled" />
                                        <Binding Path="HasUpdate" />
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="兼容" Binding="{Binding IsCompatible}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="模组详情">
                <StackPanel Margin="25,38,23,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock x:Name="LabModName" Text="（选中一个模组）" FontSize="14" FontWeight="SemiBold" />
                        <local:MyButton x:Name="BtnTranslate" Text="中/EN" Width="70" Height="28" Margin="12,0,0,0"
                                        Click="BtnTranslate_Click" Visibility="Collapsed" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="90">
                        <TextBlock x:Name="LabModDesc" Text="" TextWrapping="Wrap" Opacity="0.8" FontSize="12.5" />
                    </ScrollViewer>
                    <TextBlock x:Name="LabDeps" Text="" TextWrapping="Wrap" Opacity="0.6" FontSize="11.5"
                               Margin="0,8,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="LabReverse" Text="" TextWrapping="Wrap" Opacity="0.6" FontSize="11.5"
                               Margin="0,4,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="LabConflicts" Text="" TextWrapping="Wrap" Opacity="0.6" FontSize="11.5"
                               Margin="0,4,0,0" Foreground="Red" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock x:Name="LabModHome" Text="" Opacity="0.5" FontSize="11" VerticalAlignment="Center" />
                        <local:MyButton x:Name="BtnInstall" Text="安装 / 更新" Width="110" Height="30" Margin="16,0,0,0"
                                        ColorType="Highlight" Click="BtnInstall_Click" Visibility="Collapsed" />
                        <local:MyButton x:Name="BtnUninstall" Text="卸载" Width="80" Height="30" Margin="10,0,0,0"
                                        Click="BtnUninstall_Click" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="安装进度" x:Name="PanProgress" Visibility="Collapsed">
                <StackPanel Margin="25,38,23,18">
                    <TextBlock x:Name="LabProgress" Text="准备中…" FontSize="12" Opacity="0.8" Margin="0,0,0,6"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="BarProgress" Height="6" IsIndeterminate="True" />
                    <local:MyButton x:Name="BtnViewLog" Text="查看日志" Width="100" Height="30" Margin="0,10,0,0"
                                    Click="BtnViewLog_Click" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
