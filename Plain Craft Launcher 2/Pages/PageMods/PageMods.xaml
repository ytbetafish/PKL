<UserControl x:Class="PCL.Pages.PageMods"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部搜索栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSearch" Margin="0,0,10,0" Padding="8,6" FontSize="13"
                     KeyDown="TxtSearch_KeyDown" />
            <Button Grid.Column="1" Content="搜索" Padding="16,6" Margin="0,0,10,0" Click="BtnSearch_Click" />
            <Button Grid.Column="2" Content="已安装" Padding="16,6" Click="BtnInstalled_Click" />
        </Grid>

        <!-- 模组列表 -->
        <DataGrid x:Name="GridMods" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="GridMods_SelectionChanged" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" Background="Transparent">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="作者" Binding="{Binding Author}" Width="*" />
                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="Auto" />
                <DataGridTextColumn Header="简介" Binding="{Binding Description}" Width="3*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="状态" Width="Auto">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0}{1}">
                            <Binding Path="IsInstalled" />
                            <Binding Path="HasUpdate" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 详情区 -->
        <Border Grid.Row="2" Background="{DynamicResource ColorBrush3}" CornerRadius="6" Padding="14" Margin="0,12,0,0" MaxHeight="160">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock x:Name="LabModName" Text="（选中一个模组）" FontSize="14" FontWeight="SemiBold" />
                    <Button x:Name="BtnTranslate" Content="中/EN" Margin="12,0,0,0" Padding="10,2" FontSize="11"
                            Click="BtnTranslate_Click" Visibility="Collapsed" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="80">
                    <TextBlock x:Name="LabModDesc" Text="" TextWrapping="Wrap" Opacity="0.8" />
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="LabModHome" Text="" Opacity="0.5" FontSize="11" VerticalAlignment="Center" />
                    <Button x:Name="BtnInstall" Content="安装/更新" Margin="16,0,0,0" Padding="14,4"
                            Click="BtnInstall_Click" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 安装进度条 -->
        <Border Grid.Row="3" Background="{DynamicResource ColorBrush3}" CornerRadius="6" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed" x:Name="PanProgress">
            <StackPanel>
                <TextBlock x:Name="LabProgress" Text="准备中…" FontSize="12" Opacity="0.8" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="BarProgress" Height="6" IsIndeterminate="True" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
